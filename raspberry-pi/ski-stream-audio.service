[Unit]
Description=Ski Stream Audio duplex endpoint
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=skiaudio
SupplementaryGroups=audio
WorkingDirectory=/opt/ski-stream-audio
ExecStart=/opt/ski-stream-audio/.venv/bin/python /opt/ski-stream-audio/audio_link.py --config /etc/ski-stream-audio/config.json
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
